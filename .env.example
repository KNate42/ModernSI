# Settings of the whole stack in compose.yml. Do not copy this file by hand: run `python3 scripts/new_env.py`,
# which writes .env from it with fresh random secrets (scripts/up.sh refuses to start with "change-me" values).
# .env is ignored by git: never commit it.
# This work made by Anfinogentov Nikita

# The public address of the site, exactly as people type it, without a trailing slash.
#   On your computer:  http://localhost:8080   (plain http on port 8080, no root needed)
#   On a server:       https://modernsi.example.org   (Caddy gets a free HTTPS certificate by itself)
# The session cookie is Secure whenever this address starts with https://.
# Changing the port by hand? Change HTTP_PORT (http) or HTTPS_PORT (https) to the same number.
SITE_ADDRESS=http://localhost:8080
# Ports Caddy listens on. On a server with a domain use 80 and 443 (Let's Encrypt needs both).
HTTP_PORT=8080
HTTPS_PORT=8443

# Demo mode: made-up campuses, accounts and content, and Mailpit catching every e-mail.
# To go live, set DEMO=off, COMPOSE_PROFILES= (empty) and fill in the SMTP settings below;
# init then blocks every demo account. Best start from empty volumes: see "Going live" in README.md.
DEMO=on
COMPOSE_PROFILES=demo
# Password of every demo account. modernsi-demo (printed in the README) only for localhost;
# new_env.py makes a random one for any other address. init prints it with the demo logins.
DEMO_PASSWORD=change-me
# Mailpit's web page (demo mode only), bound to 127.0.0.1: http://127.0.0.1:8025
MAILPIT_PORT=8025
# Low-memory mode for a server with 1 GB of RAM: caps every service and loads compose.small.yml on top of
# compose.yml through the COMPOSE_FILE line below (new_env.py --small writes both; switching by hand, change both).
# With LOW_MEMORY=on, scripts/up.sh pulls the prebuilt images instead of building them. See README.md.
LOW_MEMORY=off
# COMPOSE_FILE=compose.yml:compose.small.yml
# Which prebuilt images scripts/up.sh pulls from ghcr.io: auto = the ones built from this checkout (sha-<commit>),
# so the code here and the images always match; latest = the newest of the default branch; or a release tag like v1.2.0.
# Images built here (./scripts/up.sh --build, the normal mode) are tagged with the same name.
IMAGE_TAG=auto
# Where they come from; a fork that publishes its own images: IMAGE_PREFIX=ghcr.io/<owner>/modernsi
# IMAGE_PREFIX=ghcr.io/knate42/modernsi
# One stack per machine is named modernsi-site; uncomment for a second copy next to it.
# COMPOSE_PROJECT_NAME=modernsi-second

# Secrets of the stores and the salt of anonymised request logs. Generated by scripts/new_env.py.
# Only letters and digits: they go into connection URLs.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
MONGO_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
LOG_SALT=change-me

# Outgoing mail. In demo mode it goes to Mailpit; for real mail use your provider's SMTP
# (port 587 with SMTP_STARTTLS=true is the usual choice).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=ModernSI <no-reply@modernsi.local>
