<!--
  ClickHouse server settings for the low-memory mode (LOW_MEMORY=on, compose.small.yml), for a 1 GB server.
  Mounted into /etc/clickhouse-server/config.d/. The stack only keeps a small activity feed and request logs here,
  so small caches, few background threads and no system log tables are plenty.
  This work made by Anfinogentov Nikita
-->
<clickhouse>
    <!-- a hard cap: queries and merges above it fail with MEMORY_LIMIT_EXCEEDED instead of the kernel killing the server -->
    <max_server_memory_usage>120586240</max_server_memory_usage>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <!-- the defaults reserve gigabytes for caches -->
    <mark_cache_size>16777216</mark_cache_size>
    <index_mark_cache_size>8388608</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_uncompressed_cache_size>0</index_uncompressed_cache_size>
    <mmap_cache_size>64</mmap_cache_size>
    <compiled_expression_cache_size>8388608</compiled_expression_cache_size>
    <compiled_expression_cache_elements_size>1000</compiled_expression_cache_elements_size>
    <primary_index_cache_size>8388608</primary_index_cache_size>
    <query_condition_cache_size>4194304</query_condition_cache_size>
    <query_cache remove="1"/>
    <!-- few background threads: a handful of small tables need little merging -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    <background_schedule_pool_size>8</background_schedule_pool_size>
    <background_common_pool_size>2</background_common_pool_size>
    <background_move_pool_size>1</background_move_pool_size>
    <background_fetches_pool_size>1</background_fetches_pool_size>
    <background_buffer_flush_schedule_pool_size>1</background_buffer_flush_schedule_pool_size>
    <background_message_broker_schedule_pool_size>1</background_message_broker_schedule_pool_size>
    <background_distributed_schedule_pool_size>1</background_distributed_schedule_pool_size>
    <tables_loader_foreground_pool_size>2</tables_loader_foreground_pool_size>
    <tables_loader_background_pool_size>1</tables_loader_background_pool_size>
    <max_thread_pool_size>256</max_thread_pool_size>
    <!-- these must stay below the merge slots above (4 x 2), or the server refuses to start -->
    <merge_tree>
        <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>4</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>
    <max_concurrent_queries>20</max_concurrent_queries>
    <!-- system log tables grow forever and their flush threads cost memory: none of them is needed by the site -->
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <session_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
    <blob_storage_log remove="1"/>
    <iceberg_metadata_log remove="1"/>
    <delta_lake_metadata_log remove="1"/>
    <zookeeper_log remove="1"/>
    <aggregated_zookeeper_log remove="1"/>
    <zookeeper_connection_log remove="1"/>
    <!-- the server log goes to stdout only (docker logs); no log files inside the volume -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <log remove="1"/>
        <errorlog remove="1"/>
    </logger>
</clickhouse>
